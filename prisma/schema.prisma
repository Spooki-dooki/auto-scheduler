generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // IANA time zone, e.g. "America/New_York". Everything the scheduler does is
  // computed in this zone, then converted to UTC instants for storage.
  timeZone String @default("America/New_York")

  // Which Google calendar auto-scheduled blocks are written to.
  calendarId String @default("primary")

  // Settings -> Appearance: {"theme":"calm","accents":{"calm":"apricot",
  // "momentum":"cobalt"}}. Null until the user picks; always read through
  // normalizeAppearance() (src/lib/theme/appearance.ts).
  appearance Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  profiles Profile[]
  tasks    Task[]
  blocks   TaskBlock[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  // Encrypted at rest (see src/lib/crypto.ts). Values are stored with a
  // "v1:" prefix; anything without the prefix is treated as legacy plaintext.
  refresh_token String? @db.Text
  access_token  String? @db.Text
  id_token      String? @db.Text

  expires_at        Int?
  token_type        String?
  scope             String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Scheduling models
// ---------------------------------------------------------------------------

/// A named set of weekly time windows: "Classes", "Job", "Study", "Personal".
/// A task tagged with a profile is only ever placed inside that profile's hours.
model Profile {
  id     String @id @default(cuid())
  userId String

  name  String
  color String @default("#6366f1")

  /// Minutes of breathing room left around every block scheduled in this profile.
  bufferMinutes Int @default(10)

  /// Default chunk sizing for tasks in this profile.
  defaultMinBlockMinutes Int @default(30)
  defaultMaxBlockMinutes Int @default(120)

  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  windows ProfileWindow[]
  tasks   Task[]

  @@unique([userId, name])
  @@index([userId])
}

/// One weekly recurring availability window inside a profile, expressed in the
/// user's local time as minutes from midnight (e.g. 9:00 -> 540).
model ProfileWindow {
  id        String @id @default(cuid())
  profileId String

  /// 1 = Monday ... 7 = Sunday (matches Luxon's `weekday`).
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

enum TaskStatus {
  PENDING
  SCHEDULED
  COMPLETED
  ARCHIVED
  /// Placed as far as possible, but the deadline could not be fully met.
  UNSCHEDULABLE
}

model Task {
  id     String @id @default(cuid())
  userId String

  title String
  notes String?

  deadline        DateTime
  durationMinutes Int

  /// 1 = low, 2 = normal, 3 = high, 4 = critical. Higher wins ties.
  priority Int @default(2)

  /// Chunking bounds. A 6h task with max 120 becomes several sittings.
  minBlockMinutes Int @default(30)
  maxBlockMinutes Int @default(120)

  profileId String?
  status    TaskStatus @default(PENDING)

  /// Set when the scheduler could not fit everything before the deadline.
  shortfallMinutes Int @default(0)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  blocks  TaskBlock[]

  @@index([userId, status])
  @@index([userId, deadline])
}

/// A concrete chunk of time the scheduler reserved for a task, mirrored to
/// Google Calendar as a real event.
model TaskBlock {
  id     String @id @default(cuid())
  taskId String
  userId String

  start DateTime
  end   DateTime

  googleEventId String?
  calendarId    String  @default("primary")

  /// True once the user's calendar shows this block.
  synced Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, start])
}
