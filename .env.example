# ---- Database -------------------------------------------------------------
# Any Postgres works. Free options: Neon, Supabase, Vercel Postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Local dev: http://localhost:3000 . Production: your deployed origin.
AUTH_URL="http://localhost:3000"
# Needed when deploying anywhere that is not Vercel.
AUTH_TRUST_HOST="true"

# ---- Google OAuth ---------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Token encryption at rest ---------------------------------------------
# 32 bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# ---- Optional: email (magic link) sign-in ---------------------------------
# Leave blank to offer Google sign-in only.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="login@yourdomain.com"

# ---- Cron -----------------------------------------------------------------
# Required for background re-planning. Without it /api/cron/reschedule refuses
# every request. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` when set as a project env var.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
